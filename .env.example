# Copy to .env and adjust for local/dev use. Docker Compose reads this file
# both for its own ${VAR} substitution and as env_file for web/worker/mcp.

# --- Django -----------------------------------------------------------
DJANGO_ENV=dev
DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Europe/Berlin
DJANGO_LOG_LEVEL=INFO

# --- Sentry (error monitoring) -----------------------------------------
# Leave SENTRY_DSN empty to disable Sentry entirely (no init, no network).
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
# SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false

# --- PostgreSQL + pgvector ---------------------------------------------
POSTGRES_DB=findus
POSTGRES_USER=findus
POSTGRES_PASSWORD=findus
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Fixed embedding dimension for all pgvector columns (changing this later
# requires re-embedding the archive).
FINDUS_EMBEDDING_DIMENSIONS=1024

# --- Redis (cache + Django-Q2 broker) -----------------------------------
REDIS_URL=redis://redis:6379/0
FINDUS_WORKER_COUNT=2

# --- Object storage (MinIO locally, S3-compatible in prod) -------------
FINDUS_STORAGE_ACCESS_KEY=findus
FINDUS_STORAGE_SECRET_KEY=findus-secret
FINDUS_STORAGE_BUCKET=findus-documents
FINDUS_STORAGE_ENDPOINT_URL=http://minio:9000
FINDUS_STORAGE_REGION=eu-central-1
FINDUS_STORAGE_USE_SSL=false

# --- MCP service (SSE) ---------------------------------------------------
# MCP_HOST is the bind address inside the container; see docker-compose.yml
# for how the mcp service's port is published (host-loopback only).
MCP_HOST=0.0.0.0
MCP_PORT=8001
# Required: a long random secret, e.g. `openssl rand -hex 32`. The MCP
# client (Claude Desktop) sends it as `...?token=<MCP_TOKEN>` in the SSE
# URL -- without a matching value here, every MCP request gets a 401.
MCP_TOKEN=
# The Django username MCP tools run as (see apps.mcp.auth.get_mcp_user);
# their queries are scoped to whatever that user can see via visible_to().
MCP_USER_USERNAME=

# --- Chunking (apps.documents.chunking / apps.documents.processing) ------
FINDUS_CHUNK_SIZE_TOKENS=500
FINDUS_CHUNK_OVERLAP_TOKENS=50
FINDUS_CHUNK_EMBEDDING_BATCH_SIZE=64

# --- Ähnliche Dokumente / Querverweise (apps.documents.retrieval) ---------
# Cap N und Relevanz-Schwellwert (Kosinus-Ähnlichkeit) für den
# "Ähnliche Dokumente"-Block im Dokument-Detail. MIN_SCORE höher setzen =
# weniger, dafür deutlichere Treffer. CANDIDATE_CHUNKS begrenzt, wie viele
# Chunk-Treffer die kNN-Query liefert, bevor auf Dokument-Ebene aggregiert
# wird. PICKER_LIMIT = wie viele Dokumente die Auswahlliste für den
# manuellen Querverweis anbietet (die zuletzt erfassten).
FINDUS_SIMILAR_DOCUMENTS_LIMIT=5
FINDUS_SIMILAR_DOCUMENTS_MIN_SCORE=0.7
FINDUS_SIMILAR_DOCUMENTS_CANDIDATE_CHUNKS=200
FINDUS_DOCUMENT_LINK_PICKER_LIMIT=200

# --- Kennungen/Referenznummern (apps.documents.references) ----------------
# Exakter Match statt Ähnlichkeit: Dokumente, die dieselbe Kennung tragen
# (Aktenzeichen, Forderungs-/Kunden-/Belegnummer, IBAN, „Ihr/Unser
# Zeichen"). MATCH_LIMIT = wie viele verwandte Dokumente je Kennung im
# Detail stehen (reine Anzeigegrenze, kein Relevanz-Schwellwert -- ein
# exakter Treffer ist immer relevant; eine Kürzung wird angezeigt).
FINDUS_REFERENCE_MATCH_LIMIT=20

# Auto-Zuordnung über Kennungen (apps.documents.reference_matching):
# Vorgang und Kontakt hinterlegen ihre eigenen Kennungen, ein neues
# Dokument mit passender Kennung wird ihnen *vorgeschlagen*. AUTO_ASSIGN=
# true ordnet zusätzlich ohne Klick zu -- aber nur bei genau einem
# Kandidaten und nur auf einer der AUTO_ASSIGN_TYPES-Kennungsarten.
# Default aus: eine still danebengegangene Zuordnung fällt nicht auf,
# ein unzugeordnetes Dokument schon.
FINDUS_REFERENCE_AUTO_ASSIGN=false
FINDUS_REFERENCE_AUTO_ASSIGN_TYPES=aktenzeichen,iban

# --- Fokus-Graph (apps.documents.graph) -----------------------------------
# Wie viele Nachbarn eine einzelne Expansion im Netzwerk-Diagramm (/graph)
# höchstens nachlädt, je Kantengruppe. Höher = mehr Kontext, aber schnell
# unlesbar; abgeschnittene Nachbarn werden in der UI als Hinweis gemeldet.
# Die Ähnlichkeitskanten nutzen FINDUS_SIMILAR_DOCUMENTS_LIMIT/-MIN_SCORE.
FINDUS_GRAPH_NEIGHBOR_LIMIT=25

# --- Handlungsempfehlungen je Vorgang (apps.documents.recommendations) ----
# Nur auf Knopfdruck, ein generate()-Call pro Generierung. Datenbasis sind
# die Zusammenfassungen/Key-Facts der Vorgangs-Dokumente (keine Volltexte).
# MAX_DOCUMENTS = wie viele Dokumente höchstens in den Prompt gehen (die
# jüngsten; eine Kürzung wird im Panel angezeigt, nicht verschwiegen),
# MAX_SUMMARY_CHARS = Länge je Zusammenfassung, MAX_ITEMS = Obergrenze an
# Empfehlungen pro Lauf, MAX_OUTPUT_TOKENS = Output-Budget des Calls.
# Das Budget muss Lage-Einschätzung *und* alle Empfehlungen fassen -- ist es
# zu knapp, bricht die Antwort mitten im Satz ab; dann wird der Call mit dem
# doppelten Budget wiederholt, statt das abgeschnittene JSON zu flicken.
FINDUS_VORGANG_RECOMMENDATION_MAX_DOCUMENTS=40
FINDUS_VORGANG_RECOMMENDATION_MAX_SUMMARY_CHARS=800
FINDUS_VORGANG_RECOMMENDATION_MAX_ITEMS=8
FINDUS_VORGANG_RECOMMENDATION_MAX_OUTPUT_TOKENS=4000
# Task-Timeout des Empfehlungs-Jobs (Sekunden) -- ueberschreibt den kurzen
# Q_CLUSTER["timeout"]-Default, weil ein LLM-Call mit Retries laenger
# braucht (#1134). Muss kleiner sein als Q_CLUSTER["retry"] (config/settings/
# base.py), sonst laeuft der Job bei einer Ueberschreitung doppelt.
FINDUS_VORGANG_RECOMMENDATION_TASK_TIMEOUT_SECONDS=600
# Obergrenze fuers Panel-Polling (Sekunden): verschwindet der Worker
# spurlos, hoert die UI nach dieser Zeit von selbst auf zu drehen, statt
# unbegrenzt zu pollen. Groesser als TASK_TIMEOUT_SECONDS oben.
FINDUS_VORGANG_RECOMMENDATION_POLL_TIMEOUT_SECONDS=1200

# --- KI-Entwurf einer Brief-Vorlage (apps.documents.letter_template_ai) ---
# „Mit KI erstellen" im Vorlagen-Formular: ein generate()-Call pro Klick,
# synchron im Request. MAX_PLACEHOLDERS = Obergrenze an Platzhalter-
# Vorschlägen, MAX_OUTPUT_TOKENS = Output-Budget für Anleitung + Liste.
FINDUS_LETTER_TEMPLATE_DRAFT_MAX_PLACEHOLDERS=12
FINDUS_LETTER_TEMPLATE_DRAFT_MAX_OUTPUT_TOKENS=3000

# --- KI-Brief aus einer Vorlage (apps.documents.letter_generation) --------
# Ein generate()-Call pro Entwurf, async im Worker. CONTEXT_MAX_CHARS =
# wie viel vom beantworteten Dokument in den Prompt geht (Zusammenfassung,
# ersatzweise Textauszug), MAX_OUTPUT_TOKENS = Budget für Betreff + Brieftext.
# Word (python-docx) und PDF (fpdf2) werden direkt gerendert -- es gibt
# bewusst KEINE Konverter-Systemabhängigkeit (kein LibreOffice headless).
FINDUS_LETTER_CONTEXT_MAX_CHARS=4000
FINDUS_LETTER_MAX_OUTPUT_TOKENS=3000

# --- Extraction cascade (apps.documents.extraction) -----------------------
# Text-layer -> OCR -> Vision AI; a page only escalates past the current
# stage when its output is shorter than MIN_CHARS_PER_PAGE, or -- for OCR
# -- also below MIN_OCR_CONFIDENCE.
FINDUS_EXTRACTION_MIN_CHARS_PER_PAGE=20
FINDUS_EXTRACTION_MIN_OCR_CONFIDENCE=60
FINDUS_EXTRACTION_OCR_LANGUAGES=deu+eng
FINDUS_EXTRACTION_PDF_RENDER_DPI=200

# --- AI provider layer (apps.ai.providers) -------------------------------
# Embeddings, generation and vision (describe_image) are picked independently
# -- e.g. embeddings via local Ollama (no key needed, no data leaves the
# container) and generation via a cloud provider. Provider name must be one
# of: openai, anthropic, gemini, ollama (vision: only openai, ollama --
# Anthropic/Gemini have no vision adapter yet).
FINDUS_AI_EMBEDDING_PROVIDER=ollama
FINDUS_AI_GENERATION_PROVIDER=ollama
FINDUS_AI_VISION_PROVIDER=ollama

FINDUS_AI_TIMEOUT_SECONDS=30
FINDUS_AI_MAX_RETRIES=3
FINDUS_AI_RETRY_BACKOFF_SECONDS=0.5

# Ollama (local, no key)
FINDUS_OLLAMA_BASE_URL=http://localhost:11434
FINDUS_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
FINDUS_OLLAMA_GENERATION_MODEL=llama3.1
FINDUS_OLLAMA_VISION_MODEL=llava

# OpenAI (cloud, key never logged -- see apps/ai/providers)
FINDUS_OPENAI_API_KEY=
FINDUS_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
FINDUS_OPENAI_GENERATION_MODEL=gpt-4o-mini
FINDUS_OPENAI_VISION_MODEL=gpt-4o-mini

# Anthropic / Claude (cloud, generation only -- no embeddings endpoint)
FINDUS_ANTHROPIC_API_KEY=
FINDUS_ANTHROPIC_GENERATION_MODEL=claude-sonnet-5
# Pflichtfeld der Anthropic-API und Obergrenze, keine Reservierung: der
# Default gilt für alle Calls, die kein eigenes Budget mitgeben.
FINDUS_ANTHROPIC_MAX_TOKENS=4096

# Google Gemini (cloud)
FINDUS_GEMINI_API_KEY=
FINDUS_GEMINI_EMBEDDING_MODEL=text-embedding-004
FINDUS_GEMINI_GENERATION_MODEL=gemini-2.5-flash

# --- Mail-Versand (apps.mail.backends) ------------------------------------
# Backend is picked independently of everything else above. Must be one of:
# smtp, graph, fake.
FINDUS_MAIL_BACKEND=smtp
FINDUS_MAIL_FROM_ADDRESS=findus@localhost

# Basis-URL fuer Links in Benachrichtigungsmails (z. B. Wiedervorlage-
# Erinnerungen, #1125) -- ein Hintergrundjob hat keinen Request, aus dem
# sich das schema/host raten liesse.
FINDUS_BASE_URL=http://localhost:8000

FINDUS_MAIL_TIMEOUT_SECONDS=30
FINDUS_MAIL_MAX_RETRIES=3
FINDUS_MAIL_RETRY_BACKOFF_SECONDS=0.5

# SMTP backend
FINDUS_SMTP_HOST=localhost
FINDUS_SMTP_PORT=587
FINDUS_SMTP_USERNAME=
FINDUS_SMTP_PASSWORD=
FINDUS_SMTP_USE_TLS=true
FINDUS_SMTP_USE_SSL=false

# Microsoft Graph backend (app registration with Mail.Send application
# permission, admin-consented; client-credentials flow)
FINDUS_GRAPH_TENANT_ID=
FINDUS_GRAPH_CLIENT_ID=
FINDUS_GRAPH_CLIENT_SECRET=
FINDUS_GRAPH_SENDER=

# --- Ingest: Ordner-Connector (apps.ingest) -------------------------------
# Eingangsordner als "<pfad>[:<department>[:<visibility>]]", mehrere durch
# ";" getrennt, z. B. "/data/ingest/it:IT;/data/ingest/hr:HR:private".
FINDUS_INGEST_WATCH_FOLDERS=
FINDUS_INGEST_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tif,tiff,docx,txt,eml
FINDUS_INGEST_POLL_INTERVAL_SECONDS=10

# --- Ingest: UI-Upload (apps.documents.views.document_upload) ------------
# Wiederverwendet FINDUS_INGEST_ALLOWED_EXTENSIONS oben für den Typ-Check.
FINDUS_UPLOAD_MAX_SIZE_MB=25

# --- Ingest: Mail-Connectoren (apps.ingest.connectors.mail_imap / mail_graph) --
# Der eigentliche Wert-Keil: jede ungelesene Mail wird zu einem Leitdokument
# aus dem Body (kind=mail_body), die Anhänge hängen als Unterdokumente daran;
# die Mail wird danach als gelesen markiert.
FINDUS_INGEST_MAIL_POLL_INTERVAL_SECONDS=60

# Substanz-Check des Mail-Bodys (#1070): ab dieser Wortzahl im bereinigten
# Body wird ein Body-PDF + Index-Text erzeugt; darunter bleibt das
# Leitdokument eine dünne Hülle (nur Metadaten), Anhänge hängen trotzdem daran.
FINDUS_MAIL_BODY_MIN_WORDS=8

# Grampf-Filter für Mail-Anhänge (#1081): filtert typische Signatur-/Deko-
# Bilder (Social-Logos, winzige Inline-Grafiken, Tracking-Pixel), damit sie
# nicht als Unterdokumente landen. Nur *Bilder* (image/*) werden verworfen,
# PDF/Office/echte Belege nie. FILTER_ENABLED=false schaltet ihn komplett ab.
# Verworfen wird ein Bild, wenn es inline/per cid: im Body referenziert ist,
# unter MIN_IMAGE_BYTES liegt (0 = aus) oder kleiner als MIN_IMAGE_DIMENSION px
# in Breite oder Höhe ist (0 = aus; fängt auch 1px-Tracking-Pixel).
FINDUS_INGEST_ATTACHMENT_FILTER_ENABLED=true
FINDUS_INGEST_ATTACHMENT_MIN_IMAGE_BYTES=20480
FINDUS_INGEST_ATTACHMENT_MIN_IMAGE_DIMENSION=200

# Minuten-Takt der django-q2-Schedule "mail-ingest", die `watch_mail_ingest
# --once` auslöst (siehe apps.ingest.schedules) -- der qcluster-Worker
# (findus-worker) muss dafür laufen.
FINDUS_MAIL_POLL_MINUTES=5

# IMAP-Postfach
FINDUS_INGEST_IMAP_ENABLED=false
FINDUS_INGEST_IMAP_HOST=
FINDUS_INGEST_IMAP_PORT=993
FINDUS_INGEST_IMAP_USERNAME=
FINDUS_INGEST_IMAP_PASSWORD=
FINDUS_INGEST_IMAP_USE_SSL=true
FINDUS_INGEST_IMAP_FOLDER=INBOX
FINDUS_INGEST_IMAP_DEPARTMENT=
FINDUS_INGEST_IMAP_VISIBILITY=department
FINDUS_INGEST_IMAP_ON_DUPLICATE=skip
FINDUS_INGEST_IMAP_INGEST_BODY=true

# Microsoft-Graph-Postfach (nutzt FINDUS_GRAPH_TENANT_ID/CLIENT_ID/CLIENT_SECRET
# von oben -- dieselbe App-Registrierung, zusätzlich Mail.Read (application)
# für FINDUS_INGEST_GRAPH_MAILBOX admin-consented)
FINDUS_INGEST_GRAPH_ENABLED=false
FINDUS_INGEST_GRAPH_MAILBOX=
FINDUS_INGEST_GRAPH_FOLDER=inbox
FINDUS_INGEST_GRAPH_DEPARTMENT=
FINDUS_INGEST_GRAPH_VISIBILITY=department
FINDUS_INGEST_GRAPH_ON_DUPLICATE=skip
FINDUS_INGEST_GRAPH_INGEST_BODY=true
